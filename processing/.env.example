# Server
PORT=3001
NODE_ENV=development

# Log verbosity (pino levels): trace, debug (default — logs everything),
# info, warn, error, fatal, or silent (logs nothing). The startup banner
# line (listening port) always prints regardless of this setting.
LOG_LEVEL=debug

# Shared media root (compose mounts media-data at /media).
# Originals:   $MEDIA_STORAGE_DIRECTORY/original
# Transcoded:  $MEDIA_STORAGE_DIRECTORY/transcoded
# Thumbnails:  $MEDIA_STORAGE_DIRECTORY/thumbnails
MEDIA_STORAGE_DIRECTORY=media

# Web API callbacks (complete / fail file versions after ffmpeg)
API_BASE_URL=http://localhost:3000
INTERNAL_SERVICE_TOKEN=dev-internal-token

# BullMQ / Redis connection (compose service name is `redis`)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Leave blank if your Redis instance has no auth configured (e.g. local dev).
REDIS_PASSWORD=

# Max attempts per transcode job before it's marked permanently failed
# (exponential backoff between retries).
TRANSCODE_JOB_ATTEMPTS=3

# Number of jobs the worker processes at once from the shared transcode
# queue (renditions, thumbnails, and hash jobs all share one queue). Above 1,
# a cheap thumbnail job can run in a free slot instead of queuing behind a
# multi-minute rendition transcode. Raise cautiously - each concurrent job
# runs its own ffmpeg process.
TRANSCODE_WORKER_CONCURRENCY=2

# Transcoding
ENABLE_TRANSCODING=true

# Duplicate-upload content hashing (ffmpeg decoded-frame sha256, used by the
# Web API's duplicate-upload-detection feature). The actual on/off switch is
# ENABLE_DUPLICATE_UPLOAD_DETECTION in the Web API's .env - this container
# just needs to be reachable and have ffmpeg available; no gating happens
# here. Documented for reference only.
ENABLE_DUPLICATE_UPLOAD_DETECTION=false

# These three vars govern which transcode profiles CAN use hardware
# acceleration on this deployment - each profile's own hardwareAccelerated
# flag (set in the Web API) decides whether it DOES. Hardware becomes
# available only when both ENABLE_HW_ACCELERATED_TRANSCODING and
# GPU_ACCELERATION_DEVICE are set; the encoder list must be a JSON array, and
# a hardware profile's videoCodec must exactly match one of these entries or
# its job is skipped (not queued, not a request error) rather than run.
# Software profiles always run regardless of these settings.
ENABLE_HW_ACCELERATED_TRANSCODING=false
GPU_ACCELERATION_DEVICE=/dev/dri/renderD128
HW_ACCELERATED_TRANSCODING_ENCODERS=["h264_qsv","hevc_qsv"]
