# API base URL the SPA calls when run via `npm run dev` (Vite dev server).
# Only used for local, non-Docker development - Docker deployments set the
# API origin at container start via the compose-level API_BASE_URL var
# instead (see docker-entrypoint.sh / docs/deployment.md).
VITE_API_BASE_URL=http://localhost:3000

# Comma-separated curated defaults offered in the admin "Output Container"
# dropdown (AdminTranscodeProfiles.jsx) before falling back to its
# "Other..." free-text token. Purely a UI convenience list - the server only
# validates outputContainer as a safe ffmpeg token, not a fixed enum (see
# requireSafeToken in processing/lib/transcode.js). Only used for local,
# non-Docker development - Docker deployments set this at container start
# via the compose-level TRANSCODE_CONTAINER_OPTIONS var instead.
VITE_TRANSCODE_CONTAINER_OPTIONS=mp4,webm
