# Justintube target
# Full base URL of the justintube public API, no trailing slash.
JUSTINTUBE_API_BASE_URL=http://localhost:3000/api/v1
# The jt_... API key used to authenticate against JUSTINTUBE_API_BASE_URL.
# migrate-user-videos.js: must belong to the exact justintube user videos are
# migrated into, with content_edit or full_access scope, uploader=true, and a
# verified email (same requirements as a normal upload).
# fix-missing-media-types.js: must belong to an admin (POST /videos/:id/
# media-type/repopulate is admin-only) with full_access scope.
JUSTINTUBE_API_KEY=

# MediaCMS source database (read-only credentials recommended)
MEDIACMS_DB_HOST=localhost
MEDIACMS_DB_PORT=5432
MEDIACMS_DB_NAME=mediacms
MEDIACMS_DB_USER=mediacms
MEDIACMS_DB_PASSWORD=

# Local filesystem path mounted to MediaCMS's MEDIA_ROOT (original videos are
# read from MEDIACMS_MEDIA_ROOT/<files_media.media_file>, thumbnails from
# MEDIACMS_MEDIA_ROOT/<files_media.thumbnail or uploaded_thumbnail>).
# A Windows UNC path to a network share also works, e.g.
# MEDIACMS_MEDIA_ROOT=\\networked.server\directory\folder
MEDIACMS_MEDIA_ROOT=/path/to/mediacms/media_files

# --- fix-missing-media-types.js only ---
# media_type isn't readable in bulk or filterable via any public endpoint, so
# finding affected rows still needs a direct, read-only connection to
# justintube's own MySQL database (SQLite deployments aren't supported by
# this script). Fixing each row goes entirely through JUSTINTUBE_API_BASE_URL/
# JUSTINTUBE_API_KEY above (POST /videos/:id/media-type/repopulate).
JUSTINTUBE_MYSQL_HOST=localhost
JUSTINTUBE_MYSQL_PORT=3306
JUSTINTUBE_MYSQL_DATABASE=justintube
JUSTINTUBE_MYSQL_USER=justintube
JUSTINTUBE_MYSQL_PASSWORD=
