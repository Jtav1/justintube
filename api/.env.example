# Server
PORT=3000

# Database client: "sqlite" (local dev, default) or "mysql"
DB_CLIENT=sqlite

# SQLite (used when DB_CLIENT=sqlite). Path is relative to the api/ directory.
SQLITE_FILE=db/data/justintube.sqlite

# MySQL database connection (used when DB_CLIENT=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=justintube
MYSQL_USER=justintube
MYSQL_PASSWORD=password
MYSQL_CONNECTION_LIMIT=10

MEDIA_STORAGE_DIRECTORY=media

# All possible filetypes
FILETYPES_ALLOWED=mp4,mkv,webm,wav,mp3
