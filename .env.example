# Justintube — root environment file for `docker compose up`.
#
# Copy to `.env` and fill in every value marked REQUIRED before running in
# production:
#
#   cp .env.example .env
#
# `docker compose up` will refuse to start (with a clear error naming the
# missing variable) if any REQUIRED value is left blank. See
# docs/deployment.md for the full production hardening checklist.

### Secrets — REQUIRED, no defaults. Generate with e.g. `openssl rand -hex 32`.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MEILI_MASTER_KEY=
INTERNAL_SERVICE_TOKEN=
REDIS_PASSWORD=
SESSION_SECRET=

### Seeded admin user — optional. Leave both blank to skip creating an admin
### account entirely (you can promote/create one another way instead).
ADMIN_USERNAME=
ADMIN_PASSWORD=

### Database
MYSQL_DATABASE=justintube
MYSQL_USER=justintube
MYSQL_CONNECTION_LIMIT=10

### Public URLs — override to your real hostname(s) in production.
### CORS_ORIGIN must exactly match the browser origin serving the webview
### (scheme + host + port), or credentialed API requests will be rejected.
### API_BASE_URL is the origin the webview's browser-side JS calls; it's
### injected into the running container at start time (see
### webview/docker-entrypoint.sh) — no image rebuild needed to change it.
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:3000

### Ports (host-side)
PORT=3000
WEBVIEW_PORT=5173
PROCESSING_PORT=3001
# db/redis/search are internal-only by default (no host port published) - the
# vars below are only read if you add a docker-compose.override.yml exposing
# them for local tooling (DB GUI, RedisInsight, etc.). See docs/deployment.md.
MYSQL_PORT=3306
REDIS_PORT=6379
MEILI_PORT=7700

### Reverse proxy
### Number of reverse-proxy hops to trust ahead of webapi (secure cookies,
### req.secure, and rate-limit IPs all depend on this). 1 is correct for a
### single fronting load balancer/reverse proxy terminating TLS.
TRUST_PROXY=1
SESSION_COOKIE_SECURE=true

### Feature flags
ENABLE_ACCOUNT_REGISTRATION=false
REQUIRE_EMAIL_VERIFICATION=false
ENABLE_ADVANCED_SEARCH=true
# Exposes GET /docs and GET /openapi.json publicly when true. Keep false in
# production unless you specifically want the API schema/UI public.
ENABLE_API_DOCS=false
# Seeds User1/User2/Mod1 demo accounts, all with password "password". Must
# stay false in any real deployment.
SEED_DEMO_USERS=false

### Search (Meilisearch)
MEILI_ENV=production
MEILI_INDEX_NAME=videos

### Cron
TRANSCODE_RECONCILE_CRON=*/5 * * * *
TRANSCODE_RECONCILE_STALE_MINUTES=15
SEARCH_REINDEX_ENABLED=true
SEARCH_REINDEX_CRON=0 3 * * *

### File uploads — comma-separated allowed extensions per upload type.
FILETYPES_ALLOWED=mp4,mkv,webm,wav,mp3,m4a,aac,flac,ogg
THUMBNAIL_FILETYPES_ALLOWED=jpg,jpeg,png,webp
AVATAR_FILETYPES_ALLOWED=jpg,jpeg,png,webp
BANNER_FILETYPES_ALLOWED=jpg,jpeg,png,webp
THEME_IMAGE_FILETYPES_ALLOWED=jpg,jpeg,png,webp

### Outbound email (optional — leave blank to disable verification emails)
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=true
MAIL_FROM_ADDRESS=
