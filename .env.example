# Justintube — root environment file for `docker compose up`.
#
# Copy to `.env` and fill in every value marked REQUIRED before running in
# production:
#
#   cp .env.example .env
#
# `docker compose up` will refuse to start (with a clear error naming the
# missing variable) if any REQUIRED value is left blank. See
# docs/deployment.md for the full production hardening checklist.

### Secrets — REQUIRED, no defaults. Generate with e.g. `openssl rand -hex 32`.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MEILI_MASTER_KEY=
INTERNAL_SERVICE_TOKEN=
REDIS_PASSWORD=
SESSION_SECRET=

### Seeded admin user — optional. Leave both blank to skip creating an admin
### account entirely (you can promote/create one another way instead).
ADMIN_USERNAME=
ADMIN_PASSWORD=

### Database
MYSQL_DATABASE=justintube
MYSQL_USER=justintube
MYSQL_CONNECTION_LIMIT=10


### Ownership of files written into the host data directories below by the
### webapi/processing/webview containers. Match this to a real user on the
### host if you want files readable/writable from outside Docker.
PUID=1000
PGID=1000

### GPU passthrough for hardware-accelerated transcoding (processing
### service). Only relevant if ENABLE_HW_ACCELERATED_TRANSCODING=true below
### AND the `devices:` line under the `processing` service in
### docker-compose-prod.yml is uncommented. RENDER_GID must match the group
### that owns /dev/dri/renderD128 on THIS host - find it with:
###   stat -c '%g' /dev/dri/renderD128
RENDER_GID=

### Host paths for persistent data. Each is independent - point them at
### whatever layout this server uses (e.g. media on a separate bulk-storage
### mount). Directories are created automatically on first run.
DB_DATA_PATH=./data/db
REDIS_DATA_PATH=./data/redis
SEARCH_DATA_PATH=./data/search
MEDIA_DATA_PATH=./data/media
SITEDATA_DATA_PATH=./data/sitedata

### Public URLs — override to your real hostname(s) in production.
### CORS_ORIGIN must exactly match the browser origin serving the webview
### (scheme + host + port), or credentialed API requests will be rejected.
### API_BASE_URL is the origin the webview's browser-side JS calls; it's
### injected into the running container at start time (see
### webview/docker-entrypoint.sh) — no image rebuild needed to change it.
### PUBLIC_API_URL is webapi's own externally-reachable origin, read
### server-side by webapi to build absolute links (e.g. the og:image/
### og:video URLs in its link-unfurl route) — distinct from API_BASE_URL
### (what the browser's JS calls) even though they're usually the same value
### in a single-host deployment. Set it to an https:// host to enable
### Twitter/X Player Card inline video playback.
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:3000

### Ports (host-side)
PORT=3000
WEBVIEW_PORT=5173
PROCESSING_PORT=3001
# db/redis/search are internal-only by default (no host port published) - the
# vars below are only read if you add a docker-compose.override.yml exposing
# them for local tooling (DB GUI, RedisInsight, etc.). See docs/deployment.md.
MYSQL_PORT=3306
REDIS_PORT=6379
MEILI_PORT=7700

### Reverse proxy
### Number of reverse-proxy hops to trust ahead of webapi (secure cookies,
### req.secure, and rate-limit IPs all depend on this). 1 is correct for a
### single fronting load balancer/reverse proxy terminating TLS.
TRUST_PROXY=1
SESSION_COOKIE_SECURE=true

### Feature flags
ENABLE_ACCOUNT_REGISTRATION=false
REQUIRE_EMAIL_VERIFICATION=false
# Emails every admin with an email address set when a user completes email
# verification. Also requires SMTP_HOST/MAIL_FROM_ADDRESS below to be set.
ENABLE_ADMIN_NEW_USER_NOTIFICATIONS=false
ENABLE_ADVANCED_SEARCH=true
# Exposes GET /docs and GET /openapi.json publicly when true. Keep false in
# production unless you specifically want the API schema/UI public.
ENABLE_API_DOCS=false
# Seeds User1/User2/Mod1 demo accounts, all with password "password". Must
# stay false in any real deployment.
SEED_DEMO_USERS=false

### Search (Meilisearch)
MEILI_ENV=production
MEILI_INDEX_NAME=videos

### Cron
TRANSCODE_RECONCILE_CRON=*/5 * * * *
TRANSCODE_RECONCILE_STALE_MINUTES=15
SEARCH_REINDEX_ENABLED=true
SEARCH_REINDEX_CRON=0 3 * * *

### Timeout for the processing service's yt-dlp download call, in ms (default
### 15 minutes if unset). POST /videos/import doesn't block on this, so it
### can safely be generous.
DOWNLOAD_REQUEST_TIMEOUT_MS=900000

### File uploads — comma-separated allowed extensions per upload type.
FILETYPES_ALLOWED=mp4,mkv,webm,wav,mp3,m4a,aac,flac,ogg
THUMBNAIL_FILETYPES_ALLOWED=jpg,jpeg,png,webp
AVATAR_FILETYPES_ALLOWED=jpg,jpeg,png,webp
BANNER_FILETYPES_ALLOWED=jpg,jpeg,png,webp
THEME_IMAGE_FILETYPES_ALLOWED=jpg,jpeg,png,webp

### Outbound email (optional — leave blank to disable verification emails)
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=true
MAIL_FROM_ADDRESS=
