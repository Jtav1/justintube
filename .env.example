# Justintube root environment file.
#
# Copy to `.env` and fill in every value marked *REQUIRED* before running in
# production:
#
#   cp .env.example .env
#
# if any *REQUIRED* value is left blank `docker compose up` will refuse to start
# READ THE ENTIRE CONFIG!!



##################### REQUIRED CONFIGS THAT YOU SHOULD CHANGE #####################

### *REQUIRED* 
# PUBLIC_APP_URL - the actual externally accessible URL for your instance
# CORS_ORIGIN must exactly match the browser origin - at minimum the PUBLIC_APP_URL
# PUBLIC_API_URL - external URL for your api (This is required and must be https:// for link unfurling)
# API_BASE_URL - the internal use API URL for your client to reach the API
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:3000

### *REQUIRED* DB connection info if using MYSQL and not SQLITE Generate with e.g. `openssl rand -hex 32`.
MYSQL_ROOT_PASSWORD=
MYSQL_USER=justintube
MYSQL_PASSWORD=
MYSQL_PORT=3306
MYSQL_DATABASE=justintube
# Optional - Default should work fine
MYSQL_CONNECTION_LIMIT=10

### *REQUIRED* Ports for webapi, webview, processing api (more ports below if you want to expose more stuff)
PORT=3000
WEBVIEW_PORT=5173

### *REQUIRED* Secrets, no defaults. Generate with e.g. `openssl rand -hex 32`.
MEILI_MASTER_KEY=
INTERNAL_SERVICE_TOKEN=
REDIS_PASSWORD=
SESSION_SECRET=

### *REQUIRED* Seeded admin user. This will create an admin acct ONLY if it doesnt exist
# Log in with this user and SET A NEW PASSWORD before exposing this site to the internet
ADMIN_USERNAME=
ADMIN_PASSWORD=



##################### OPTIONAL FEATURES #####################


### You actually have to set this to true to turn on account registration
ENABLE_ACCOUNT_REGISTRATION=false

### Advanced search (Meilisearch) - if ENABLE_... is set to false, 
# then you don't have to run the Search service
ENABLE_ADVANCED_SEARCH=true
MEILI_ENV=production
MEILI_INDEX_NAME=videos
SEARCH_REINDEX_ENABLED=true
SEARCH_REINDEX_CRON=0 3 * * *

### Optional - Outbound email (leave blank to disable outgoing emails)
# Note this is required for acct verification or notifications to work properly
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=true
MAIL_FROM_ADDRESS=

# SMTP info must be complete before setting this to true to enable acct verification emails
REQUIRE_EMAIL_VERIFICATION=false

# SMTP info must be complete before setting this to true to enable emailing admins about new user reg
ENABLE_ADMIN_NEW_USER_NOTIFICATIONS=false

### Optional - Periodic notification email digest for "like"/"comment"/
# "subscription" notifications
NOTIFICATION_EMAIL_DIGEST_ENABLED=true
NOTIFICATION_EMAIL_DIGEST_CRON=0 * * * *

### Optional - If transcoding, video importing, and duplicate detection set to false
# then you don't have to run the Processing service
ENABLE_TRANSCODING=true
ENABLE_VIDEO_IMPORTS=true
ENABLE_DUPLICATE_UPLOAD_DETECTION=true

### Optional - Hours of day when dedupe hashes can be calculated (processing-heavy!), FIFO if left blank
# i.e. 0-6 (00:00-06:00), 22-2 (22:00-02:00) to control GPU usage
HASH_GENERATION_WINDOW=0-6

### OPTIONAL - Hardware Accelerated Transcoding Options
ENABLE_HW_ACCELERATED_TRANSCODING=false
TRANSCODE_RECONCILE_CRON=*/5 * * * *
TRANSCODE_RECONCILE_STALE_MINUTES=15
# GPU passthrough device - MUST be passed to Processing container
RENDER_GID=

### Optional - Reverse proxy
# Number of reverse-proxy hops to trust ahead of webapi
TRUST_PROXY=1
SESSION_COOKIE_SECURE=true

# Exposes GET /docs and GET /openapi.json publicly when true. Keep false in
# production unless you specifically want the API schema/UI public.
ENABLE_API_DOCS=false



##################### Acceptable Default Configs #####################

# Allowed file extensions for video/audio upload
FILETYPES_ALLOWED=mp4,mkv,webm,wav,mp3,m4a,aac,flac,ogg

# Allowed file extensions that we can transcode to acceptable web formats
# IF transcoding is enabled, and the containers to transcode into
FILETYPES_CONVERTIBLE=mov,avi,wmv,flv,mpg,mpeg,m4v,3gp,ts,wma,aiff,aif,amr
TRANSCODE_CONTAINER_OPTIONS=mp4,webm

THUMBNAIL_FILETYPES_ALLOWED=jpg,jpeg,png,webp
AVATAR_FILETYPES_ALLOWED=jpg,jpeg,png,webp
BANNER_FILETYPES_ALLOWED=jpg,jpeg,png,webp
THEME_IMAGE_FILETYPES_ALLOWED=jpg,jpeg,png,webp

### Host paths for persistent data. Directories are created automatically on first run
# Update these as needed or point your volumes to these - these should all be persisted volumes
DB_DATA_PATH=./data/db
REDIS_DATA_PATH=./data/redis
SEARCH_DATA_PATH=./data/search
MEDIA_DATA_PATH=./data/media
SITEDATA_DATA_PATH=./data/sitedata

### Log verbosity for webapi and processing.
# DEBUG logs everything (default). ERROR logs only failures. NONE logs nothing.
LOG_LEVEL=DEBUG

# Timeout for the processing service's yt-dlp download call, in ms
DOWNLOAD_REQUEST_TIMEOUT_MS=900000

### Optional - Seeds User1/User2/Mod1 demo accounts, all with password "password".
# FOR DEV INSTANCES ONLY for testing and development purposes. Do not enable this in prod.
SEED_DEMO_USERS=false

### Optional - Seeds 5 default H.264/AAC/MP4 video transcode profiles
# (240p-1080p) on first boot. Existing profiles are left alone on later
# boots; set to false to skip and manage profiles manually.
SEED_DEFAULT_TRANSCODE_PROFILES=true

### Optional - set these to real user/group on host if you want files readable/writable from outside containers
PUID=1000
PGID=1000

### Optional - defaults should work fine
REDIS_PORT=6379
MEILI_PORT=7700
PROCESSING_PORT=3001



## EXPERIMENTAL ##

### Livestreaming 
# Note: this is totally untested. We worked on it but decided not to finish up
# due to networking requirements and our production environment config
ENABLE_LIVESTREAM=false

# These must both be externally accessible URLs for users to stream to and view
RTMP_INGEST_URL=rtmp://localhost:1935/live
HLS_BASE_URL=http://localhost:8888
