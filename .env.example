# Justintube — root environment file for `docker compose up`.
#
# Copy to `.env` and fill in every value marked *REQUIRED* before running in
# production:
#
#   cp .env.example .env
#
# `docker compose up` will refuse to start (with a clear error naming the
# missing variable) if any *REQUIRED* value is left blank. See
# docs/deployment.md for the full production hardening checklist.

### *REQUIRED* Secrets — REQUIRED, no defaults. Generate with e.g. `openssl rand -hex 32`.
MYSQL_ROOT_PASSWORD=
MYSQL_USER=justintube
MYSQL_PASSWORD=
MYSQL_PORT=3306

MEILI_MASTER_KEY=
INTERNAL_SERVICE_TOKEN=
REDIS_PASSWORD=
SESSION_SECRET=

MYSQL_DATABASE=justintube
MYSQL_CONNECTION_LIMIT=10


### *REQUIRED* Ports (host-side, internal use)
PORT=3000
WEBVIEW_PORT=5173
PROCESSING_PORT=3001

### Optional - only required if you want to expose them thru the host
REDIS_PORT=6379
MEILI_PORT=7700


### *REQUIRED* Seeded admin user. This will create an admin acct if the acct does not exist
ADMIN_USERNAME=
ADMIN_PASSWORD=

### Optional - Seeds User1/User2/Mod1 demo accounts, all with password "password".
# FOR DEV INSTANCES ONLY. Do not enable this in prod.
SEED_DEMO_USERS=false


### OPTIONAL - Ownership of files written into the host data directories below by the
# webapi/processing/webview containers. Match this to a real user on the
# host if you want files readable/writable from outside Docker.
PUID=1000
PGID=1000


### Optional - advanced search (Meilisearch)
MEILI_ENV=production
MEILI_INDEX_NAME=videos
SEARCH_REINDEX_ENABLED=true
SEARCH_REINDEX_CRON=0 3 * * *

### OPTIONAL - Hardware Accelerated Transcoding Options
# This controls how FFmpeg in the Processing container is used

ENABLE_HW_ACCELERATED_TRANSCODING=false
TRANSCODE_RECONCILE_CRON=*/5 * * * *
TRANSCODE_RECONCILE_STALE_MINUTES=15

### GPU passthrough for hardware-accelerated transcoding (processing
# service). Required if ENABLE_HW_ACCELERATED_TRANSCODING=true below
RENDER_GID=


### File uploads — comma-separated allowed extensions per upload type.
FILETYPES_ALLOWED=mp4,mkv,webm,wav,mp3,m4a,aac,flac,ogg
THUMBNAIL_FILETYPES_ALLOWED=jpg,jpeg,png,webp
AVATAR_FILETYPES_ALLOWED=jpg,jpeg,png,webp
BANNER_FILETYPES_ALLOWED=jpg,jpeg,png,webp
THEME_IMAGE_FILETYPES_ALLOWED=jpg,jpeg,png,webp


### Optional - Host paths for persistent data. Directories are created automatically on first run.
DB_DATA_PATH=./data/db
REDIS_DATA_PATH=./data/redis
SEARCH_DATA_PATH=./data/search
MEDIA_DATA_PATH=./data/media
SITEDATA_DATA_PATH=./data/sitedata


### *REQUIRED* 
# PUBLIC_APP_URL - the actual externally accessible URL for your instance
# CORS_ORIGIN must exactly match the browser origin - at minimum the PUBLIC_APP_URL
# PUBLIC_API_URL - external URL for your api (This is required and must be https:// for link unfurling)
# API_BASE_URL - the internal use API URL for your client to reach the API
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:3000


### Optional - Livestreaming 
# Note: this is totally untested. We worked on it but decided not to finish up
# due to networking requirements and our production environment config
ENABLE_LIVESTREAM=false

# These must both be externally accessible URLs for users to stream to and view
RTMP_INGEST_URL=rtmp://localhost:1935/live
HLS_BASE_URL=http://localhost:8888


### Optional - Reverse proxy
# Number of reverse-proxy hops to trust ahead of webapi
TRUST_PROXY=1
SESSION_COOKIE_SECURE=true


### *REQUIRED* Other feature flags - required but have defaults.
ENABLE_ACCOUNT_REGISTRATION=false
REQUIRE_EMAIL_VERIFICATION=false

# Emails every admin with an email address set when a user completes email
# verification. Also requires SMTP_HOST/MAIL_FROM_ADDRESS below to be set.
ENABLE_ADMIN_NEW_USER_NOTIFICATIONS=false
ENABLE_ADVANCED_SEARCH=true

# Set either of these to false to stop webapi from ever contacting the
# `processing` container, so you can run without it entirely. Uploads still
# work with ENABLE_TRANSCODING=false - the original file just stays the only
# playable rendition (no transcoded renditions, no generated thumbnail).
ENABLE_TRANSCODING=true
ENABLE_VIDEO_IMPORTS=true

# Exposes GET /docs and GET /openapi.json publicly when true. Keep false in
# production unless you specifically want the API schema/UI public.
ENABLE_API_DOCS=false

# Timeout for the processing service's yt-dlp download call, in ms
DOWNLOAD_REQUEST_TIMEOUT_MS=900000


### Optional - Outbound email (leave blank to disable verification emails)
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=true
MAIL_FROM_ADDRESS=
