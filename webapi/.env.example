# This file documents local/dev defaults only. For production deployment via
# docker-compose, see the root .env.example and docs/deployment.md.

# Server
PORT=3000
NODE_ENV=development

# Number of reverse-proxy hops to trust (sets Express "trust proxy"; affects
# secure cookies, req.secure, and rate-limit IPs). 1 is correct for a single
# fronting load balancer/reverse proxy; use "loopback" or a CIDR list for
# other topologies. Irrelevant when running with no proxy in front (dev).
TRUST_PROXY=1

# Session (HTTP-only cookie auth for the website)
SESSION_SECRET=change-me-in-development
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_MS=604800000

# Comma-separated browser origins allowed for credentialed CORS.
# In production (NODE_ENV=production), leave empty to disable cross-origin CORS
# until you set an explicit allowlist. In development, empty reflects the request Origin.
CORS_ORIGIN=

# Database client: "sqlite" (local dev, default) or "mysql"
DB_CLIENT=sqlite

# SQLite (used when DB_CLIENT=sqlite). Path is relative to the webapi/ directory.
SQLITE_FILE=db/data/justintube.sqlite

# MySQL database connection (used when DB_CLIENT=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=justintube
MYSQL_USER=justintube
MYSQL_PASSWORD=password
MYSQL_CONNECTION_LIMIT=10

# Media root (original uploads are written under MEDIA_STORAGE_DIRECTORY/original)
MEDIA_STORAGE_DIRECTORY=media

# Sitedata root (site-owned images not tied to a specific video, e.g. avatars
# under SITEDATA_STORAGE_DIRECTORY/avatars)
SITEDATA_STORAGE_DIRECTORY=media/sitedata

# Max avatar upload size in bytes (default 5 MiB if unset)
MAX_AVATAR_SIZE_BYTES=5242880

# Comma-separated allowed avatar upload extensions (no leading dots)
AVATAR_FILETYPES_ALLOWED=jpg,jpeg,png,webp

# Max banner upload size in bytes (default 5 MiB if unset)
MAX_BANNER_SIZE_BYTES=5242880

# Comma-separated allowed banner upload extensions (no leading dots)
BANNER_FILETYPES_ALLOWED=jpg,jpeg,png,webp

# Max thumbnail upload size in bytes (default 5 MiB if unset)
MAX_THUMBNAIL_SIZE_BYTES=5242880

# Comma-separated allowed thumbnail upload extensions (no leading dots)
THUMBNAIL_FILETYPES_ALLOWED=jpg,jpeg,png,webp

# Max theme background image upload size in bytes (default 5 MiB if unset)
MAX_THEME_IMAGE_SIZE_BYTES=5242880

# Comma-separated allowed theme background image upload extensions (no leading dots)
THEME_IMAGE_FILETYPES_ALLOWED=jpg,jpeg,png,webp

# Max multipart upload size in bytes (default 2 GiB if unset)
MAX_UPLOAD_SIZE_BYTES=2147483648

# Comma-separated allowed upload extensions (no leading dots)
FILETYPES_ALLOWED=mp4,mkv,webm,wav,mp3,m4a,aac,flac,ogg

# Processing service (used to enqueue transcodes after upload when profiles exist)
PROCESSING_API_URL=http://localhost:3001

# Transcoding feature flag (same name as, but independent of, processing's
# own ENABLE_TRANSCODING - that one gates the /transcode endpoint itself;
# this one decides whether webapi ever calls it). Default true. When "false",
# uploads/imports never call the processing service's /transcode endpoint -
# the original file is kept as the only playable rendition (no FILE_VERSIONS
# renditions, no generated thumbnail). Set false if you're running without
# the `processing` container at all.
ENABLE_TRANSCODING=true

# URL import feature flag. Default true. When "false", POST /videos/import
# and GET /videos/import/status never contact the processing service (which
# performs the actual yt-dlp download) - import requests are rejected
# up front and the status endpoint always reports unavailable.
ENABLE_VIDEO_IMPORTS=true

# Timeout for the processing service's yt-dlp download call, in ms (default 15
# minutes if unset). POST /videos/import no longer blocks on this, so it can
# safely be generous.
DOWNLOAD_REQUEST_TIMEOUT_MS=900000

# Shared with the processing service for complete/fail callbacks, and with
# the streaming (MediaMTX) service for its publish-auth and lifecycle
# callbacks into /internal/livestreams/*.
INTERNAL_SERVICE_TOKEN=dev-internal-token

# Livestreaming feature flag. When not "true", the stream-key/livestream
# routes (public and internal) are unmounted entirely (404) and
# GET /api/v1/config reports livestreamEnabled: false so the webview hides
# the Go Live / watch-live UI. Requires the `streaming` (MediaMTX) container
# from docker-compose.yml to actually be running for streams to work.
ENABLE_LIVESTREAM=false

# RTMP ingest URL shown to users on the Go Live page for their OBS/encoder
# "Server" field - same value for every user. OBS appends the user's raw
# stream key itself (its "Stream Key" field), so the resulting publish path
# is unique per user without any userId in this URL.
RTMP_INGEST_URL=rtmp://localhost:1935/live

# Base URL (scheme+host+port, no trailing slash) the streaming service's HLS
# output is reachable at. Used to build GET /livestreams/:id/playback URLs
# as `${HLS_BASE_URL}/live/{userId}/index.m3u8`.
HLS_BASE_URL=http://localhost:8888

# Stale FILE_VERSIONS reconciliation (API-side cron)
TRANSCODE_RECONCILE_ENABLED=true
TRANSCODE_RECONCILE_CRON=*/5 * * * *
TRANSCODE_RECONCILE_STALE_MINUTES=15

# Nightly Meilisearch reindex (API-side cron). Only relevant when
# ENABLE_ADVANCED_SEARCH=true — the default in-process search backend stays
# instantly consistent and ignores these.
SEARCH_REINDEX_ENABLED=true
SEARCH_REINDEX_CRON=0 3 * * *

# Auth / accounts
ENABLE_ACCOUNT_REGISTRATION=false
REQUIRE_EMAIL_VERIFICATION=false
# Emails every admin with an email address set when a user completes email
# verification. Also requires SMTP_HOST/MAIL_FROM_ADDRESS below to be set.
ENABLE_ADMIN_NEW_USER_NOTIFICATIONS=false
# Reserved for future SSO routes (not read by the app yet)
ENABLE_SSO=false

# Advanced search (Meilisearch). When false/unset, /search endpoints respond
# with 403 search_disabled and no Meilisearch container is required.
ENABLE_ADVANCED_SEARCH=false
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev-meili-master-key
MEILI_INDEX_NAME=videos

# Seeded admin user (created once on boot when both are set)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

# Demo accounts (User1/User2/Mod1, all password "password") seeded on boot.
# Defaults on outside production, off when NODE_ENV=production; set explicitly
# to override either way. Must stay false/unset in any real deployment.
SEED_DEMO_USERS=true

# Exposes GET /docs (Scalar UI) and GET /openapi.json. Defaults on outside
# production, off when NODE_ENV=production; set explicitly to override.
ENABLE_API_DOCS=true

# Outbound email (verification links). Email is enabled only when SMTP_HOST and
# MAIL_FROM_ADDRESS are both non-empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Nodemailer `secure`: must be "true" or "false" (not "TLS"). Port 587 usually uses false + STARTTLS.
SMTP_SECURE=false
MAIL_FROM_ADDRESS=

# Public frontend base URL for links in verification emails (no trailing slash)
PUBLIC_APP_URL=http://localhost:5173

# Public, externally-reachable base URL of this webapi service itself (no
# trailing slash). Used only to build ABSOLUTE og:image/og:video URLs in the
# link-unfurl HTML route (GET /api/v1/videos/:id/unfurl) - bots (Slack,
# Discord, Twitter, etc.) fetch those image/video URLs directly over the
# public internet and cannot resolve relative paths or the Docker-internal
# "webapi:3000" hostname. Typically the same externally-reachable host as
# API_BASE_URL (in webview/.env / docker-compose.yml) - kept as a separate
# var because this one is read server-side by webapi itself, not by the
# webview container. Falls back to http://localhost:$PORT when unset (dev
# only - unusable for real unfurls since bots cannot reach localhost). Must
# be HTTPS for Twitter/X Player Card inline video playback to activate
# (GET /api/v1/videos/:id/player) - falls back to a rich card with no inline
# playback otherwise.
PUBLIC_API_URL=http://localhost:3000
